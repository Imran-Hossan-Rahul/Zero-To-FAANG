#include <iostream>
#include <vector>
using namespace std;


int main(){

    vector<int> nums = {1,1,2,3,3,4,4,8,8};

    int n = nums.size();
    int start = 0, end = n - 1;

    while(start <= end){

        int mid = start + ((end - start) / 2);

        if(nums[mid - 1] != nums[mid] && nums[end] != nums[mid + 1]){

            cout << nums[mid];

            return 0;
        }

        if((end - mid) % 2 == 0){
            end = mid - 1;
        } else{
            start = mid + 1;
        }

    }

    return 0;
}